# Backend API
BACKEND_URL=https://api.seans.tedeshi.ru
WORKER_REG_SECRET=

# Worker identity (defaults to OS hostname).
# Also used for the qBittorrent Web UI domain: <WORKER_NAME>.w.seans.tedeshi.ru
# WORKER_NAME=worker-01

# qBittorrent
QBIT_URL=http://qbittorrent:8080
QBIT_API_KEY=

# Paths (shared volume between qbit and agent containers)
QBIT_DOWNLOADS=/downloads
STAGING_DIR=/staging
# Host-каталог для загрузок. Укажите путь на конкретной машине с достаточным
# местом на диске, например: /mnt/staging (Linux) или E:/seans-staging (Windows)
STAGING_HOST_DIR=/mnt/staging

# S3 (buckets.ru)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://s3.buckets.ru
S3_BUCKET=seans
S3_REGION=ru-1

# Mock mode (for development without S3)
MOCK_S3=true

# Timing
CLAIM_INTERVAL_SEC=10
MAX_CONCURRENT_TASKS=1
HEARTBEAT_INTERVAL_SEC=60
DOWNLOAD_STALL_TIMEOUT_MIN=30
TORRENT_METADATA_TIMEOUT=300
TASK_MAX_HOURS=12
DRAIN_ON_SHUTDOWN=false
DRAIN_TIMEOUT_SEC=3600

# State directory (rclone.conf, logs)
STATE_DIR=/state

# Progressive streaming: S3 segment size in MiB (default 8).
# While a torrent downloads, finished segments are uploaded so clients can
# play early. Seek is limited to the contiguous downloaded prefix.
STREAM_SEGMENT_SIZE_MB=8
